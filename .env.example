# Gemini API Key (required) — get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Model (optional, defaults to gemini-2.0-flash)
# Supported models from Google AI Studio:
#   - gemini-2.5-pro-preview-05-06
#   - gemini-2.5-flash-preview-05-20
#   - gemini-2.0-flash
#   - gemini-2.0-flash-lite
#   - gemini-1.5-pro
#   - gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash
